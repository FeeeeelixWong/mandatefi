# Required for the real five-agent committee and portfolio-manager review.
DEEPSEEK_API_KEY=

# Current DeepSeek OpenAI-compatible API and recommended model split.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SPECIALIST_MODEL=deepseek-v4-flash
DEEPSEEK_MANAGER_MODEL=deepseek-v4-pro

# Comma-separated browser origins allowed to call the review API.
MANDATEFI_ALLOWED_ORIGINS=http://localhost:5173

# Optional Neon/Postgres audit persistence. Without it, structured audit events
# are written to Vercel logs and complete decisions remain in browser storage.
DATABASE_URL=

# Only needed when the frontend and API are deployed on different origins.
# VITE_AGENT_API_URL=https://your-mandatefi-api.vercel.app
